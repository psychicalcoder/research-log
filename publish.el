;;; publish.el --- org-publish configuration for the research log  -*- lexical-binding: t; -*-

;; Usage:
;;   emacs --batch -l publish.el -f my/publish        ; incremental
;;   emacs --batch -l publish.el -f my/publish-all    ; force rebuild
;; or `make'.  Inside Emacs: M-x load-file RET publish.el RET, then
;; M-x org-publish-project RET site RET.

(require 'ox-publish)
(require 'ox-html)

;;; Paths -------------------------------------------------------------

(defvar my/site-root
  (file-name-directory (or load-file-name buffer-file-name))
  "Directory containing publish.el.")

(defun my/path (rel) (expand-file-name rel my/site-root))

;;; Identity ----------------------------------------------------------

(defvar my/site-name  "Marvin Liu")
(defvar my/site-tagline "Research log")
(defvar my/site-author "Marvin Liu")

;;; Global export tweaks ---------------------------------------------

;; #+DATE: <2026-09-16 Wed>  ->  "2026-09-16"  (no <angle brackets>, no weekday)
(setq org-export-date-timestamp-format "%Y-%m-%d")

;; Emit semantic classes (.org-keyword, .org-string ...) instead of
;; inline colours copied from the current Emacs theme.  Requires the
;; `htmlize' package for highlighting; without it code is plain, which
;; is also fine.
(setq org-html-htmlize-output-type 'css)

;; A blank line between paragraphs in the source is a paragraph, not a <br>.
(setq org-export-preserve-breaks nil)

;; Smart quotes and en/em-dashes from -- and ---.
(setq org-export-with-smart-quotes t)

;;; Preamble / postamble ---------------------------------------------

(defun my/root-prefix (info)
  "Relative path from the file being exported back to the site root."
  (let* ((in   (plist-get info :input-file))
         (base (my/path "org/"))
         (rel  (file-relative-name (file-name-directory in) base))
         (depth (if (string= rel "./") 0
                  (length (split-string (directory-file-name rel) "/" t)))))
    (apply #'concat (make-list depth "../"))))

(defun my/html-preamble (info)
  "Site navigation, plus a dateline on posts."
  (let* ((root   (my/root-prefix info))
         (in     (plist-get info :input-file))
         (post-p (string-match-p "/posts/[^/]+\\.org\\'" in))
         (date   (let ((d (org-export-get-date info "%Y-%m-%d")))
                   (if (stringp d) d (org-export-data d info)))))
    (concat
     (format "<nav class=\"site-nav\">
  <a class=\"site-name\" href=\"%sindex.html\">%s</a>
  <span class=\"site-links\"><a href=\"%sindex.html\">Log</a><a href=\"%sabout.html\">About</a></span>
</nav>\n" root my/site-name root root)
     (when (and post-p (org-string-nw-p date))
       (format "<p class=\"dateline\"><time datetime=\"%s\">%s</time></p>\n" date date)))))

(defun my/html-postamble (_info)
  (format "<p class=\"colophon\">© %s %s · Written in <a href=\"https://orgmode.org\">Org mode</a></p>"
          (format-time-string "%Y") my/site-author))

;;; Sitemap: the home page is the list of posts -----------------------

(defun my/sitemap-entry (entry _style project)
  "One line per post: ISO date, title, optional #+DESCRIPTION."
  (if (directory-name-p entry)
      entry
    (let* ((date  (format-time-string "%Y-%m-%d" (org-publish-find-date entry project)))
           (title (org-publish-find-title entry project))
           (desc  (let ((d (org-publish-find-property entry :description project (quote html))))
                    (and d (org-no-properties (org-element-interpret-data d))))))
      (concat
       (format "@@html:<time datetime=\"%s\">%s</time>@@ [[file:posts/%s][%s]]" date date entry title)
       (when (org-string-nw-p desc)
         (format "\n@@html:<span class=\"entry-desc\">%s</span>@@" desc))))))

(defun my/sitemap (title list)
  "Generate org/index.org: the intro fragment followed by the post list.
LIST is (unordered (\"entry\") ...).  We assemble the text ourselves
because `org-list-to-org' drops the @@html:...@@ snippets."
  (concat "# GENERATED by publish.el on every build. Edit _intro.org, not this file.\n"
          "#+TITLE: " title "\n"
          "#+OPTIONS: title:nil\n\n"
          "#+INCLUDE: \"_intro.org\"\n\n"
          "#+ATTR_HTML: :class entries\n"
          (mapconcat (lambda (item)
                       (concat "- " (replace-regexp-in-string "\n" "\n  " (car item))))
                     (cdr list) "\n")
          "\n"))

;;; Shared HTML options -----------------------------------------------

(defvar my/html-head
  "<link rel=\"stylesheet\" href=\"%1$scss/style.css\" type=\"text/css\">
<link rel=\"icon\" href=\"%1$simg/favicon.ico\" sizes=\"24x24\">")

;; :html-head accepts a string only, so we inject the relative path via a
;; filter on the final output instead.
(defun my/fix-head (output _backend info)
  (replace-regexp-in-string "@@ROOT@@" (my/root-prefix info) output t t))

(defvar my/common-html-options
  `(:html-doctype "html5"
    :html-html5-fancy t
    :html-divs ((preamble  "header" "preamble")
                (content   "main"   "content")
                (postamble "footer" "postamble"))
    :html-container "section"
    :html-head-include-default-style nil
    :html-head-include-scripts nil
    :html-head ,(format my/html-head "@@ROOT@@")
    :html-preamble my/html-preamble
    :html-postamble my/html-postamble
    :html-validation-link nil
    :time-stamp-file nil
    :html-link-use-abs-url nil
    :html-table-default-attributes nil
    :html-inline-images t
    :html-checkbox-type unicode
    ;; Text
    :section-numbers nil
    :with-toc nil
    :with-author nil
    :with-email nil
    :with-date nil
    :with-creator nil
    :with-title t
    :with-latex t
    :with-sub-superscript {}
    :with-smart-quotes t
    :with-tags nil
    :headline-levels 4
    :language "en"))

;;; Projects ----------------------------------------------------------

(setq org-publish-project-alist
      `(("posts"
         :base-directory ,(my/path "org/posts/")
         :base-extension "org"
         :publishing-directory ,(my/path "html/posts/")
         :publishing-function org-html-publish-to-html
         :recursive nil
         ;; The sitemap *is* the home page.  It is written one level up
         ;; as org/index.org and published by this project.
         :auto-sitemap t
         :sitemap-filename "../index.org"
         :sitemap-title ,(concat my/site-name " — " my/site-tagline)
         :sitemap-style list
         :sitemap-sort-files anti-chronologically
         :sitemap-format-entry my/sitemap-entry
         :sitemap-function my/sitemap
         ,@my/common-html-options)

        ("pages"
         :base-directory ,(my/path "org/")
         :base-extension "org"
         :exclude "\\`\\(_\\|index\\.org\\)"     ; _fragments, and index.org (posts project owns it)
         :publishing-directory ,(my/path "html/")
         :publishing-function org-html-publish-to-html
         :recursive nil
         ,@my/common-html-options)

        ("static"
         :base-directory ,(my/path "org/")
         :base-extension "css\\|woff2\\|png\\|jpg\\|jpeg\\|svg\\|gif\\|pdf\\|txt\\|ico"
         :recursive t
         :publishing-directory ,(my/path "html/")
         :publishing-function org-publish-attachment)

        ("site" :components ("posts" "pages" "static"))))

(add-to-list 'org-export-filter-final-output-functions #'my/fix-head)

;;; Entry points ------------------------------------------------------

(defun my/publish ()
  (org-publish-project "site"))

(defun my/publish-all ()
  (org-publish-project "site" t))

(provide 'publish)
;;; publish.el ends here
